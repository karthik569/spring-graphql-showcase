type Query {
    books(filter: BookFilter, sort: BookSort, limit: Int, offset: Int): [Book!]!
    bookCount(filter: BookFilter): Int!
    bookById(id: ID!): Book
    authors: [Author!]!
    authorById(id: ID!): Author
    publications: [Publication!]!
    magazineById(id: ID!): Magazine
    search(text: String!): [SearchResult!]!
    bookConnection(first: Int, after: String, filter: BookFilter, sort: BookSort): BookConnection!
    authorConnection(first: Int, after: String): AuthorConnection!
    publicationConnection(first: Int, after: String): PublicationConnection!
    magazinesPublishedAfter(since: DateTime!): [Magazine!]!
}

type Mutation {
    login(username: String!, password: String!): AuthPayload!
    addBook(input: BookInput!): Book!
    addBookResult(input: BookInput!): AddBookResult!
    updateBook(id: ID!, input: BookUpdateInput!): Book!
    deleteBook(id: ID!): Boolean!
    updateStock(id: ID!, stock: Int!): Book! @deprecated(reason: "Use updateBook instead")
}

type AuthPayload {
    accessToken: String!
    tokenType: String!
    expiresIn: Int!
}

type Subscription {
    bookAdded: Book!
}

scalar DateTime
scalar URL

interface Publication {
    id: ID!
    title: String!
}

type Book implements Publication {
    id: ID!
    title: String!
    pages: Int!
    price: Float!
    stock: Int!
    costPrice: Float!
    author: Author
}

type Magazine implements Publication {
    id: ID!
    title: String!
    issueNumber: Int!
    publisher: String!
    publishedOn: DateTime!
    website: URL
}

union SearchResult = Book | Magazine | Author

type ValidationFailed {
    message: String!
    field: String!
}

union AddBookResult = Book | ValidationFailed

type BookConnection {
    edges: [BookEdge!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type BookEdge {
    node: Book!
    cursor: String!
}

type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}

type AuthorConnection {
    edges: [AuthorEdge!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type AuthorEdge {
    node: Author!
    cursor: String!
}

type PublicationConnection {
    edges: [PublicationEdge!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type PublicationEdge {
    node: Publication!
    cursor: String!
}

type Author {
    id: ID!
    name: String!
    country: String!
    email: String!
    books: [Book!]!
}

input BookInput {
    title: String!
    pages: Int!
    price: Float!
    stock: Int!
    authorId: ID!
}

input BookUpdateInput {
    title: String
    pages: Int
    price: Float
    stock: Int
    authorId: ID
}

input BookFilter {
    titleContains: String
    authorId: ID
    minPrice: Float
    maxPrice: Float
    inStock: Boolean
}

enum BookSort {
    TITLE_ASC
    TITLE_DESC
    PRICE_ASC
    PRICE_DESC
    STOCK_ASC
    STOCK_DESC
}
